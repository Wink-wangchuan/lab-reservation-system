[Unit]
Description=lab-reservation-system redis (user-level, 127.0.0.1:6379)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/lab-reservation
ExecStart=%h/opt/redis/bin/redis-server %h/lab-reservation/redis.conf
Restart=on-failure
RestartSec=3
StandardOutput=append:%h/lab-reservation/logs/redis.log
StandardError=append:%h/lab-reservation/logs/redis.log

[Install]
WantedBy=default.target
