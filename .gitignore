# ============================================================
#  Git 忽略规则
#  原则：构建产物、依赖、IDE 配置、运行时数据、密钥一律不进仓库
# ============================================================

# ---------- Java / Maven ----------
target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar

# ---------- Node / 前端 ----------
node_modules/
dist/
dist.tgz
dist.tar.gz
# bla 加固产物与签名清单属于发布件，不入库
dist-protected*/
*.bla-manifest.json
*.local

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/

# ---------- 日志与运行时 ----------
logs/
*.log
data/

# ---------- 敏感配置 ----------
# 密钥只放在服务器 .env（chmod 600）或本地环境变量中，不进仓库
.env
.env.local
.env.*.local
*.pem
*.key
# 前端构建配置只含接口地址，需要入库
!.env.production

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 临时文件 ----------
# 截图工具曾把临时路径直接写成文件名，落到了项目根目录
UsersNebula*.png
*.tmp
