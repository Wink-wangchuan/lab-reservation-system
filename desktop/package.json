{
  "name": "labwise-desktop",
  "version": "4.5.0",
  "private": true,
  "description": "LabWise 智慧实验室预约管理系统桌面客户端",
  "author": "LabWise",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.labwise.desktop",
    "productName": "LabWise实验室预约系统",
    "copyright": "Copyright © 2026 LabWise",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "update-preload.js",
      "update.html",
      "eula.html",
      "error.html",
      "icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LabWise实验室预约系统",
      "artifactName": "LabWise-Setup-${version}.exe",
      "uninstallDisplayName": "LabWise 实验室预约系统"
    }
  }
}
